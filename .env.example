APP_NAME="ImmigrationKnowHow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=immigration_knowhow
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.elasticemail.com
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@immigrantknowhow.com
MAIL_FROM_NAME="${APP_NAME}"

# Phone OTP/SMS verification
# - cache: dev-only (OTP logged)
# - twilio: real SMS via Twilio Verify
PHONE_OTP_DRIVER=cache
PHONE_OTP_ACCEPT_ANY=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_VERIFY_CODE_LENGTH=6
TWILIO_FAKE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_UPLOAD_DISK=s3
AWS_UPLOAD_DIRECTORY=uploads
AWS_UPLOAD_VISIBILITY=private
AWS_UPLOAD_MAX_KB=1024000
AWS_UPLOAD_ALLOWED_MIMES=jpg,jpeg,png,pdf,mp3,m4a,aac,wav,ogg
AWS_UPLOAD_SIGNED_URL_TTL_MINUTES=10

# Library PDF/audio binaries. Use "local" for private local storage or "s3" for a private S3 bucket.
LIBRARY_MEDIA_DRIVER=s3
LIBRARY_MEDIA_PREFIX=library-media
LIBRARY_COVER_DISK=s3
LIBRARY_COVER_DIRECTORY=library/covers
LIBRARY_COVER_VISIBILITY=public

VITE_APP_NAME="${APP_NAME}"
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VIDEO_UPLOAD_MAX_KB=262144

# Stripe (library one-time purchases — embedded Checkout + webhooks)
# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_KEY = Publishable key (pk_test_…). STRIPE_SECRET = Secret key (sk_test_…).
# Alternate names also work: STRIPE_PUBLISHABLE_KEY, STRIPE_SECRET_KEY.
# STRIPE_WEBHOOK_URL is the endpoint you configure in Stripe (default local route below).
# After changing these, run: php artisan config:clear
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_URL=https://immigrantkhservice-production.up.railway.app/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
STRIPE_AI_ASSISTANT_PRICE_ID=

# Apple In-App Purchase (App Store Server API) — required for iOS mobile purchases
APPLE_BUNDLE_ID=com.immigrantknowhow.ikhapp
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=/var/www/ikh/storage/app/apple/SubscriptionKey_K4A5TCGDYM.p8
APPLE_IAP_SANDBOX=true
APPLE_AI_ASSISTANT_MONTHLY=com.immigrantknowhow.ikhapp.monthly.ai_assistant
APPLE_LIBRARY_PRODUCT_PREFIX=com.immigrantknowhow.ikhapp.library
APPLE_LIBRARY_EBOOK_PRODUCT_ID=EBOOK_TO2026
# Optional: limit the env product ID to one title, e.g. APPLE_LIBRARY_EBOOK_SLUG=my-ebook-slug
APPLE_LIBRARY_EBOOK_SLUG=
APPLE_PROVIDER_PRODUCT_PREFIX=com.immigrantknowhow.ikhapp.provider
APPLE_PROVIDER_MONTHLY_PRODUCT_ID=com.immigrantknowhow.ikhapp.provider.serviceprofessional_monthly
APPLE_PROVIDER_YEARLY_PRODUCT_ID=com.immigrantknowhow.ikhapp.provider.serviceprofessional_yearly
APPLE_VIDEO_PRODUCT_PREFIX=com.immigrantknowhow.ikhapp.video
APPLE_AD_PUBLISH_PRODUCT_ID=com.immigrantknowhow.ikhapp.ad.publish

AD_POST_PRICE_CENTS=2499
AD_FREE_LIMIT=3
AD_POST_CURRENCY=USD

PROVIDER_TRIAL_MONTHS=6

# ChatGPT/OpenAI summaries for purchased PDF ebooks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MAX_PDF_BYTES=5242880

# Optional: path to the uszips SQL dump (gzipped). If empty, the seeder also checks:
# - database/seeders/data/uszips.sql.gz
# - storage/app/uszips.sql.gz
# - ./uszips.sql.gz
# Windows example: C:\Users\you\Downloads\uszips.sql.gz
USZIPS_SQL_PATH=

# Manual library payments are optional and disabled by default. Stripe is the default checkout for paid library titles.
# Set LIBRARY_MANUAL_PAYMENTS_ENABLED=true only if you intentionally want bank transfer / PayPal style manual approvals.
LIBRARY_MANUAL_PAYMENTS_ENABLED=false
# Leave empty to use the built-in default text when manual payments are enabled, or set your bank / PayPal details here (multiple lines OK).
MANUAL_PAYMENT_INSTRUCTIONS=
