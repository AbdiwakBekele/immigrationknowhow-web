APP_NAME="ImmigrationKnowHow"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=immigration_knowhow
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local Mailtrap SMTP (Sandbox inbox): https://mailtrap.io/
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_LOG_CHANNEL=stack
INBOUND_EMAIL_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_UPLOAD_DISK=s3
AWS_UPLOAD_DIRECTORY=uploads
AWS_UPLOAD_VISIBILITY=private
AWS_UPLOAD_MAX_KB=10240
AWS_UPLOAD_ALLOWED_MIMES=jpg,jpeg,png,pdf
AWS_UPLOAD_SIGNED_URL_TTL_MINUTES=10

# Library PDF/audio binaries. Use "local" for private local storage or "s3" for a private S3 bucket.
LIBRARY_MEDIA_DRIVER=local
LIBRARY_MEDIA_PREFIX=library-media

VITE_APP_NAME="${APP_NAME}"
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VIDEO_UPLOAD_MAX_KB=262144

# Stripe (library one-time purchases — embedded Checkout + webhooks)
# Test keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_KEY = Publishable key (pk_test_…). STRIPE_SECRET = Secret key (sk_test_…).
# Alternate names also work: STRIPE_PUBLISHABLE_KEY, STRIPE_SECRET_KEY.
# STRIPE_WEBHOOK_URL is the endpoint you configure in Stripe (default local route below).
# After changing these, run: php artisan config:clear
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_URL=https://immigrantkhservice-production.up.railway.app/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

AD_POST_PRICE_CENTS=2500
AD_POST_CURRENCY=USD

# ChatGPT/OpenAI summaries for purchased PDF ebooks
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_SUMMARY_MAX_PDF_BYTES=5242880

# Manual library payments are optional and disabled by default. Stripe is the default checkout for paid library titles.
# Set LIBRARY_MANUAL_PAYMENTS_ENABLED=true only if you intentionally want bank transfer / PayPal style manual approvals.
LIBRARY_MANUAL_PAYMENTS_ENABLED=false
# Leave empty to use the built-in default text when manual payments are enabled, or set your bank / PayPal details here (multiple lines OK).
MANUAL_PAYMENT_INSTRUCTIONS=
